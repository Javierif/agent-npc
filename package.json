{
  "name": "claude-npc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "site": "vite --config vite.site.config.ts --port 1430",
    "site:build": "vite build --config vite.site.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "bridge": "cargo build --bin npc-bridge --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^8.0.16",
    "typescript": "~6.0.3"
  }
}
